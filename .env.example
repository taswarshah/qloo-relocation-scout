QLOO_API_KEY=your-hackathon-key
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Optional LLM for the conversational agent (tool calling) and the eval baseline.
# Any OpenAI-compatible /chat/completions endpoint with tool support, e.g.
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1/            LLM_MODEL=claude-haiku-5-5
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1           LLM_MODEL=<a tool-calling model>
#   Workers AI: LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1  LLM_MODEL=<a function-calling model>
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Tuning (optional)
QLOO_CONCURRENCY=6
QLOO_CACHE_TTL_S=3600
RATE_LIMIT_PER_MIN=12
